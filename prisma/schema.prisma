// Prisma Schema for MediCare Plus Enterprise D2C Platform
// Database: PostgreSQL (Compatible with Neon, Supabase, Railway, AWS RDS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                   String      @id
  slug                 String      @unique
  name                 String
  category             String
  subCategory          String?
  brand                String      @default("MediCare Plus")
  manufacturer         String?
  price                Float
  originalPrice        Float?
  packSize             String
  stock                Int         @default(0)
  inStock              Boolean     @default(true)
  requiresPrescription Boolean     @default(false)
  prescriptionType     String?
  images               String[]    @default([])
  description          String
  dosage               String?
  dosageForm           String      @default("Tablet")
  activeIngredient     String?
  composition          String?
  sideEffects          String[]    @default([])
  usage                String      @default("")
  warnings             String[]    @default([])
  storage              String?
  featured             Boolean     @default(false)
  bestseller           Boolean?    @default(false)
  tags                 String[]    @default([])
  rating               Float       @default(4.8)
  reviewCount          Int         @default(0)
  discountPercent      Float?
  isVisible            Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  orderItems           OrderItem[]

  @@index([category])
  @@index([slug])
}

model Order {
  id                 String            @id
  customerName       String
  customerPhone      String
  customerEmail      String
  shippingStreet     String
  shippingCity       String
  shippingState      String
  shippingPincode    String
  totalAmount        Float
  paymentMethod      String
  paymentStatus      String            @default("Pending") // Pending, Paid, Failed
  status             String            @default("Verified") // Verified, Dispensing, Dispatched, Out for Delivery, Delivered, Cancelled
  isColdChain        Boolean           @default(false)
  currentPayloadTemp String            @default("Ambient")
  deliveryOtp        String
  trackingNumber     String
  prescriptionId     String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  items              OrderItem[]
  telemetry          TelemetryRecord[]

  @@index([customerPhone])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Prescription {
  id                String   @id
  patientName       String
  patientAge        Int
  patientGender     String   @default("Other") // Male, Female, Other
  patientPhone      String
  shippingCity      String
  shippingPincode   String
  doctorName        String
  doctorRegNo       String
  clinicHospital    String
  dateIssued        String
  validUntil        String
  status            String   @default("pending") // pending, approved, rejected
  urgency           String   @default("Normal") // Normal, High
  medications       String[] @default([])
  fileUrl           String?
  pharmacistRemarks String?
  approvedBy        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([patientPhone])
  @@index([status])
}

model Refill {
  id                     String   @id
  productId              String
  productName            String
  customerName           String
  customerPhone          String
  quantity               Int      @default(1)
  intervalDays           Int      @default(30)
  nextRefillDate         String
  status                 String   @default("Active") // Active, Paused, Cancelled
  whatsappReminder       Boolean  @default(true)
  rxValidityMonths       Int      @default(6)
  remainingPillsEstimate Int      @default(30)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([customerPhone])
  @@index([status])
}

model Batch {
  batchId               String   @id
  productId             String
  productName           String
  manufacturer          String
  manufacturingFacility String
  mfgDate               String
  expiryDate            String
  purityAssayPct        Float
  heavyMetalsScreen     String
  microbialTest         String
  dissolutionRate       String
  storageVaultZone      String
  currentVaultTemp      String
  totalStockUnits       Int
  reorderLevel          Int
  releasePharmacist     String
  releaseStatus         String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([productId])
}

model TelemetryRecord {
  id        String   @id @default(cuid())
  orderId   String
  time      String
  temp      Float
  location  String
  status    String   @default("optimal") // optimal, warning
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
